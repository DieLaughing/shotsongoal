# Shots on Goal settings. Copy to .env (never commit it) and fill in. Blank = off/default.

# ---- The basics ------------------------------------------------------------------------------------------
# The address people will use (no trailing slash). Used in calendar links and approval links.
SOG_BASE_URL=https://shotsongoal.example.com
# Your email. This person is the admin: always let in, sees the Admin tab, approves everyone else.
SOG_ADMIN_EMAIL=you@example.com
# Time zone for logs and "today" on the server.
TZ=America/New_York
# Home-market team(s) for new people until they choose, e.g. BOS for a group in New England (comma-separated).
SOG_DEFAULT_LOCAL=

# ---- Sign-in: pick ONE of the two ------------------------------------------------------------------------
# A) Public on the internet behind Cloudflare Access (recommended; see the README).
#    Team domain: Zero Trust > Settings > Custom Pages > your team name, e.g. myteam.cloudflareaccess.com
SOG_ACCESS_TEAM=
#    Application Audience (AUD) tag: Zero Trust > Access > Applications > your app > Overview
SOG_ACCESS_AUD=
#
# B) Home network only, no sign-in at all: every visitor is treated as this email (use your admin email).
#    NEVER set this on a site the internet can reach - anyone could get in as you.
SOG_LOCAL_EMAIL=

# ---- Approval pushes (optional) ---------------------------------------------------------------------------
# When someone asks for access, an ntfy notification with Approve / Deny buttons goes to your phone.
# Leave blank to approve people from the Admin tab instead. ntfy.sh works, or self-host ntfy.
NTFY_URL=
NTFY_TOKEN=
SOG_NTFY_TOPIC=shotsongoal

# ---- Bug reports (optional) ------------------------------------------------------------------------------
# The in-app "Report a problem" form files GitHub issues for people (anonymously: no name or email is sent).
# Needs a fine-grained token: github.com/settings/personal-access-tokens > Generate new token > Only select
# repositories: your repo > Repository permissions: Issues = Read and write. Blank = the form opens GitHub's
# own new-issue page instead (people then need a GitHub account).
SOG_GITHUB_TOKEN=
# The repo to file into (owner/name). Point it at your fork if you run your own copy.
SOG_GITHUB_REPO=DieLaughing/shotsongoal

# ---- Ask (prototype, optional) -------------------------------------------------------------------------
# A llama.cpp server (`llama-server`, OpenAI-compatible) that reads questions on the Ask page. It only works out what
# was asked; every answer is built from the app's own data. Tested with Qwen3-4B-Instruct-2507 Q4_K_M on 4 CPU cores
# (~2-3 s a question). Empty = Ask still answers plain names ("Bruins", "Pastrnak vs Marner") and says it's warming up
# for anything else.
SOG_LLM_URL=

# ---- Cloudflare Tunnel (only with `docker compose --profile tunnel up -d`) ---------------------------------
# Zero Trust > Networks > Tunnels > Create a tunnel > Cloudflared > copy the token from the install command.
TUNNEL_TOKEN=
